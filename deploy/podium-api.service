[Unit]
Description=Podium API (FastAPI/uvicorn)
After=network.target postgresql.service docker.service
Wants=postgresql.service

[Service]
Type=simple
WorkingDirectory=/srv/apps/podium/backend
EnvironmentFile=/srv/apps/podium/backend/.env
ExecStart=/srv/apps/podium/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
