[Unit]
Description=Podium Worker (Redis background tasks)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/srv/apps/podium/backend
EnvironmentFile=/srv/apps/podium/backend/.env
ExecStart=/srv/apps/podium/backend/.venv/bin/python -m app.workers.cli
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
