# Podium - Production Environment Template
# Copy to /srv/apps/podium/backend/.env on the VPS and fill in real values.
# =============================================================================

# Application
APP_NAME=Podium
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false
API_PREFIX=/api
API_V1_PREFIX=/v1

# Server - bind to localhost, Nginx proxies /api/ -> this
HOST=127.0.0.1
PORT=8000
WORKERS=1
RELOAD=false

# Security - CHANGE THESE
SECRET_KEY=<generate: openssl rand -hex 32>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=https://manage.podiumclass.online

# Database - PostgreSQL on this VPS (127.0.0.1, NOT the docker-compose port map)
DATABASE_URL=postgresql+asyncpg://podium:<strong-password>@127.0.0.1:5432/podium
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_TASK_QUEUE=podium:tasks

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# Application management - absolute paths (working dir = /srv/apps/podium)
APPLICATIONS_DIR=/srv/apps/podium/applications
APPLICATIONS_RELOAD_INTERVAL_SECONDS=60

# Monitoring engine - production ports (drop dev 5173)
MONITORING_CACHE_TTL_SECONDS=15
MONITORING_HISTORY_POINTS=60
MONITORING_LOG_PATHS=/var/log/syslog
MONITORING_CPU_ALERT_THRESHOLD=85
MONITORING_MEMORY_ALERT_THRESHOLD=85
MONITORING_DISK_ALERT_THRESHOLD=90
MONITORING_EXPECTED_PORTS=8000,5432,6379

# Operations
OPERATIONS_BACKUP_DIR=/srv/apps/podium/.podium/backups
WORKER_SERVICE_NAME=podium-worker.service

# VPS discovery
DISCOVERY_SCAN_PATHS=/srv/apps,/var/www,/opt
DISCOVERY_MAX_DEPTH=4
DISCOVERY_AUTO_REGISTER=true
DISCOVERY_AUTO_REGISTER_EXCLUDE=/srv/apps/podium,/var/www/podium
NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
LETSENCRYPT_LIVE_DIR=/etc/letsencrypt/live
NGINX_CONFIG_PATH=/etc/nginx

# Admin lockdown - put your current public IP(s) here after first login
# ADMIN_LOCKDOWN_ENABLED=true
# ADMIN_ALLOWED_IPS=1.2.3.4,5.6.7.8
